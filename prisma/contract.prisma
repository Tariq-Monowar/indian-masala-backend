// use prisma-next

enum usersRole {
  @@type("pg/text@1")
  admin    = "admin"
  customer = "customer"
}

model users {
  id        String    @id @default(uuid())
  name      String?
  email     String    @unique
  phone     String?
  password  String?
  role      usersRole @default(customer)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
