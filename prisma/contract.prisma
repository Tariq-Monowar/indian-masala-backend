// use prisma-next

model users {
  id        String    @id @default(uuid())
  name      String?
  email     String    @unique
  phone     String?
  password  String?
  image     String?
  role      usersRole @default(customer)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum usersRole {
  @@type("pg/text@1")
  admin    = "admin"
  customer = "customer"
}


model category {
  id        String    @id @default(uuid())
  name      String?
  icon      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model menu {
  id        String    @id @default(uuid())

  food_name String?

  category_id String?
  category category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  category_name String?
  icon String?

  min_price Float?
  max_price Float?
  preparation_time Int?
  spicy_level SpicyLevel?

  menu_image menu_image[]

  description_en String?
  description_fr String?


  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum SpicyLevel {
  @@type("pg/text@1")

  mild   = "mild"
  medium = "medium"
  hot    = "hot"
}

model menu_image {
  id        String    @id @default(uuid())

  menu_id String?
  menu menu @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  image String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}




//reservation
model reservation {
  id        String    @id @default(uuid())

  number_of_guests Int?
  date DateString?
  time TimeString?

  name String?
  phone String?
  email String?
  description String?
  status ReservationStatus?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum ReservationStatus {
  @@type("pg/text@1")

  pending = "pending"
  confirmed = "confirmed"
  cancelled = "cancelled"
  completed = "completed"
}

model catering {
  id        String    @id @default(uuid())

  name String?
  phone String?
  email String?
  event_type String?
  number_of_guests Int?
  date DateString?
  location String?
  special_requirements String?
  description String?

  status CateringStatus?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum CateringStatus {
  @@type("pg/text@1")

  pending = "pending"
  confirmed = "confirmed"
  cancelled = "cancelled"
  completed = "completed"
}

model contect_us {
  id        String    @id @default(uuid())

  first_name String?
  last_name String?
  email String?
  phone String?
  message String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
